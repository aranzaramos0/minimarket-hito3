# Credenciales de ejemplo para desarrollo local. Cambialas en tu archivo .env.
# scripts/preparar.ps1 puede generar claves aleatorias sin mostrarlas.
MYSQL_ROOT_PASSWORD=cambiar_clave_root_local
MYSQL_USER=minimarket_app
MYSQL_PASSWORD=cambiar_clave_app_local
FRONTEND_PORT=8080
BACKEND_PORT=8081
MYSQL_PORT=3307
